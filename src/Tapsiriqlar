Tapşırıq 1. Kredit müraciətinin yoxlanması
class CreditApplication {
int age;
boolean blacklisted;
boolean sanctioned;
double salary;
double requestedAmount;
int workExperienceMonths;
int creditScore;

public CreditApplication (  int age,
                            boolean blacklisted,
                            boolean sanctioned,
                            double salary,
                            double requestedAmount,
                            int workExperienceMonths,
                            int creditScore) {
                      this.age=age;
                      this.blacklisted = blacklisted;
                      this.sanctioned = sanctioned;
                      this.salary = salary;
                      this.requestedAmount = requestedAmount;
                      this.workExperienceMonths = workExperienceMonths;
                      this.creditScore = creditScore;
                            }
}

abstract class CreditCheck {
     protected CreditCheck next;

     public CreditCheck setNext (CreditCHeck next) {
     this.next=next;
     return next;
     }

     public boolean check(CreditApplication application) {
      if (!process(application)) {
                 System.out.println("Müraciət rədd edildi!");
                 return false;
             }

             if (next == null) {
                 return true;
             }

             return next.check(application);
     }

     protected abstract boolean process(CreditApplication application);
}

 class AgeCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("Yaş yoxlanılır...");

         return app.age >= 18 && app.age <= 65;
     }
 }


 class BlacklistCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("Qara siyahı yoxlanılır...");

         return !app.blacklisted;
     }
 }


 class SanctionCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("Sanksiya siyahısı yoxlanılır...");

         return !app.sanctioned;
     }
 }


 class WorkExperienceCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("İş stajı yoxlanılır...");

         return app.workExperienceMonths >= 6;
     }
 }

 class SalaryLimitCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("Maaş limiti yoxlanılır...");

         return app.requestedAmount <= app.salary * 10;
     }
 }

 class CreditBureauCheck extends CreditCheck {

     @Override
     protected boolean process(CreditApplication app) {
         System.out.println("Kredit bürosuna pullu sorğu göndərildi...");

         return app.creditScore >= 600;
     }
 }


public class Main {

    public static void main(String[] args) {

        CreditCheck age = new AgeCheck();
        CreditCheck blacklist = new BlacklistCheck();
        CreditCheck sanction = new SanctionCheck();
        CreditCheck work = new WorkExperienceCheck();
        CreditCheck salary = new SalaryLimitCheck();
        CreditCheck bureau = new CreditBureauCheck();

        age.setNext(blacklist)
           .setNext(sanction)
           .setNext(work)
           .setNext(salary)
           .setNext(bureau);

        CreditApplication application =
                new CreditApplication(
                        30,
                        false,
                        false,
                        2000,
                        15000,
                        12,
                        750
                );

        boolean approved = age.check(application);

        if (approved) {
            System.out.println("Kredit təsdiqləndi!");
        } else {
            System.out.println("Kredit rədd edildi!");
        }
    }
}






Tapşırıq 2. Çatdırılma qiymətinin hesablanması - Strategy Pattern

public interface PaymentProvider {

    boolean pay(double amountInAZN);
}

public class ProviderOne {

    public int makePayment(int amountInQepik) {

        System.out.println(
            "Provider One: " + amountInQepik + " qepik"
        );


        return 0;
    }
}

public class ProviderTwo {

    public void processPayment(double amountInAZN) {

        System.out.println(
            "Provider Two: " + amountInAZN + " AZN"
        );


    }
}

public class ProviderThree {

    public boolean executePayment(double amountInUSD) {

        System.out.println(
            "Provider Three: " + amountInUSD + " USD"
        );

        return true;
    }
}

public class ProviderOneAdapter implements PaymentProvider {

    private final ProviderOne provider;

    public ProviderOneAdapter(ProviderOne provider) {
        this.provider = provider;
    }

    @Override
    public boolean pay(double amountInAZN) {

        int amountInQepik = (int) Math.round(amountInAZN * 100);

        int result = provider.makePayment(amountInQepik);

        return result == 0;
    }
}

public class ProviderTwoAdapter implements PaymentProvider {

    private final ProviderTwo provider;

    public ProviderTwoAdapter(ProviderTwo provider) {
        this.provider = provider;
    }

    @Override
    public boolean pay(double amountInAZN) {

        try {
            provider.processPayment(amountInAZN);
            return true;

        } catch (RuntimeException e) {
            return false;
        }
    }
}

public class ProviderThreeAdapter implements PaymentProvider {

    private final ProviderThree provider;

    public ProviderThreeAdapter(ProviderThree provider) {
        this.provider = provider;
    }

    @Override
    public boolean pay(double amountInAZN) {

        double amountInUSD = amountInAZN / 1.70;

        return provider.executePayment(amountInUSD);
    }
}

public class PaymentService {

    private final PaymentProvider paymentProvider;

    public PaymentService(PaymentProvider paymentProvider) {
        this.paymentProvider = paymentProvider;
    }

    public boolean makePayment(double amountInAZN) {

        return paymentProvider.pay(amountInAZN);
    }
}

public class Main {

    public static void main(String[] args) {

        // Provider 1
        PaymentProvider adapter1 =
                new ProviderOneAdapter(new ProviderOne());

        PaymentService service1 =
                new PaymentService(adapter1);

        System.out.println(
                "Payment 1: " + service1.makePayment(100)
        );


        // Provider 2
        PaymentProvider adapter2 =
                new ProviderTwoAdapter(new ProviderTwo());

        PaymentService service2 =
                new PaymentService(adapter2);

        System.out.println(
                "Payment 2: " + service2.makePayment(100)
        );


        // Provider 3
        PaymentProvider adapter3 =
                new ProviderThreeAdapter(new ProviderThree());

        PaymentService service3 =
                new PaymentService(adapter3);

        System.out.println(
                "Payment 3: " + service3.makePayment(100)
        );
    }
}




